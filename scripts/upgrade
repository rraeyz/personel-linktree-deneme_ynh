#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# STOP DOCKER CONTAINER
#=================================================
ynh_script_progression --message="Stopping Docker container..." --weight=2

cd "$install_dir"
docker-compose down

#=================================================
# UPDATE SOURCE FILES
#=================================================
ynh_script_progression --message="Updating source files..." --weight=3

ynh_setup_source --dest_dir="$install_dir" --keep=".env docker-compose.yml"

#=================================================
# REBUILD AND RESTART DOCKER CONTAINER
#=================================================
ynh_script_progression --message="Rebuilding Docker container..." --weight=10

cd "$install_dir"
docker-compose build --no-cache
docker-compose up -d

# Container'in başlamasını bekle
sleep 15

#=================================================
# UPDATE NGINX CONFIGURATION
#=================================================
ynh_script_progression --message="Updating NGINX configuration..." --weight=1

ynh_add_nginx_config

#=================================================
# UPDATE SYSTEMD SERVICE
#=================================================
ynh_add_systemd_config
ynh_systemd_action --service_name="$app" --action="restart"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression --message="Upgrade of $app completed" --last
