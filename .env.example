# Database
DATABASE_URL="file:./dev.db"

# Security - These will be auto-generated by setup wizard
# You can also set them manually before first run
JWT_SECRET="auto-generated-on-first-setup"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="set-during-initial-setup"

# Application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
PORT=3000
NODE_ENV=production

# Optional: SMTP Email Settings
# Configure these in admin panel after setup, or set them here
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com
# SMTP_FROM_NAME=Your Name

